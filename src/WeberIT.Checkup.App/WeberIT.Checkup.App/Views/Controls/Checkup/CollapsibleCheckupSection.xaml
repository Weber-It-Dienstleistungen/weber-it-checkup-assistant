<UserControl
    x:Class="WeberIT.Checkup.App.Views.Controls.Checkup.CollapsibleCheckupSection"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource PanelCardStyle}">

        <Expander
            HorizontalContentAlignment="Stretch"
            IsExpanded="{Binding IsExpanded, ElementName=Root, Mode=TwoWay}">

            <Expander.Header>

                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding Title, ElementName=Root}"
                    Style="{StaticResource SectionTitleTextStyle}" />

            </Expander.Header>

            <ContentPresenter
                Margin="0,18,0,0"
                HorizontalAlignment="Stretch"
                Content="{Binding SectionContent, ElementName=Root}" />

        </Expander>

    </Border>

</UserControl>