<UserControl
    x:Class="WeberIT.Checkup.App.Views.Controls.Checkup.CheckupDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:checkup="clr-namespace:WeberIT.Checkup.App.Views.Controls.Checkup"
    xmlns:converters="clr-namespace:WeberIT.Checkup.App.Infrastructure.Converters"
    xmlns:models="clr-namespace:WeberIT.Checkup.App.Models">

    <UserControl.Resources>

        <converters:FindingSeverityToSymbolConverter
            x:Key="FindingSeverityToSymbolConverter" />

    </UserControl.Resources>

    <StackPanel>

        <checkup:DeviceSummaryCard />

        <Grid Margin="0,24,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Linke Spalte -->

            <StackPanel Grid.Column="0">

                <!-- Hardware -->

                <checkup:CollapsibleCheckupSection
                    Title="Hardware">

                    <checkup:CollapsibleCheckupSection.SectionContent>

                        <StackPanel>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontWeight="SemiBold"
                                    Text="Prozessor:" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding HardwareInformation.ProcessorName}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,10,0,0"
                                    FontWeight="SemiBold"
                                    Text="Arbeitsspeicher:" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,10,0,0"
                                    Text="{Binding HardwareInformation.InstalledMemory}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,10,0,0"
                                    FontWeight="SemiBold"
                                    Text="Mainboard-Hersteller:" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,10,0,0"
                                    Text="{Binding HardwareInformation.MainboardManufacturer}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,10,0,0"
                                    FontWeight="SemiBold"
                                    Text="Mainboard-Modell:" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,10,0,0"
                                    Text="{Binding HardwareInformation.MainboardProduct}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,10,0,0"
                                    FontWeight="SemiBold"
                                    Text="BIOS-Hersteller:" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Margin="0,10,0,0"
                                    Text="{Binding HardwareInformation.BiosManufacturer}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Margin="0,10,0,0"
                                    FontWeight="SemiBold"
                                    Text="BIOS-Version:" />

                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Margin="0,10,0,0"
                                    Text="{Binding HardwareInformation.BiosVersion}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Margin="0,10,0,0"
                                    FontWeight="SemiBold"
                                    Text="TPM-Status:" />

                                <TextBlock
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Margin="0,10,0,0"
                                    Text="{Binding HardwareInformation.TpmStatus}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Row="7"
                                    Grid.Column="0"
                                    Margin="0,10,0,0"
                                    FontWeight="SemiBold"
                                    Text="TPM-Version:" />

                                <TextBlock
                                    Grid.Row="7"
                                    Grid.Column="1"
                                    Margin="0,10,0,0"
                                    Text="{Binding HardwareInformation.TpmVersion}"
                                    TextWrapping="Wrap" />

                            </Grid>

                            <TextBlock
                                Margin="0,24,0,0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Grafikkarten" />

                            <ItemsControl
                                Margin="0,8,0,0"
                                ItemsSource="{Binding HardwareInformation.GraphicsCards}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="12"
                                            Background="{StaticResource BackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">

                                            <TextBlock
                                                Text="{Binding}"
                                                TextWrapping="Wrap" />

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </checkup:CollapsibleCheckupSection.SectionContent>

                </checkup:CollapsibleCheckupSection>

                <!-- Datenträger -->

                <checkup:CollapsibleCheckupSection
                    Margin="0,24,0,0"
                    Title="Datenträger">

                    <checkup:CollapsibleCheckupSection.SectionContent>

                        <StackPanel>

                            <TextBlock
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Physische Datenträger und zugehörige Windows-Volumes des gescannten Systems."
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,20,0,0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Physische Laufwerke" />

                            <ItemsControl
                                Margin="0,10,0,0"
                                ItemsSource="{Binding StorageInformation.PhysicalDrives}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <checkup:PhysicalDriveInformationCard />

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <TextBlock
                                Margin="0,20,0,0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Volumes / Laufwerksbuchstaben" />

                            <ItemsControl
                                Margin="0,10,0,0"
                                ItemsSource="{Binding StorageInformation.Volumes}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="14"
                                            Background="{StaticResource BackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DriveLetter}" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="16,0,0,0"
                                                    Text="{Binding DriveType}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="16,0,0,0"
                                                    Text="{Binding FileSystem}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    Grid.Column="3"
                                                    Margin="16,0,0,0"
                                                    Text="{Binding TotalSize}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    Grid.Column="4"
                                                    Margin="16,0,0,0"
                                                    Text="{Binding FreeSpace}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    Grid.Column="5"
                                                    Margin="16,0,0,0"
                                                    Text="{Binding IsReady}" />

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </checkup:CollapsibleCheckupSection.SectionContent>

                </checkup:CollapsibleCheckupSection>

                <!-- System / Software -->

                <checkup:CollapsibleCheckupSection
                    Margin="0,24,0,0"
                    Title="System / Software">

                    <checkup:CollapsibleCheckupSection.SectionContent>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontWeight="SemiBold"
                                Text="Windows:" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding OperatingSystemInformation.Name}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,10,0,0"
                                FontWeight="SemiBold"
                                Text="Version:" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,10,0,0"
                                Text="{Binding OperatingSystemInformation.Version}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,10,0,0"
                                FontWeight="SemiBold"
                                Text="Build:" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,10,0,0"
                                Text="{Binding OperatingSystemInformation.BuildNumber}" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,10,0,0"
                                FontWeight="SemiBold"
                                Text="Architektur:" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,10,0,0"
                                Text="{Binding OperatingSystemInformation.Architecture}" />

                        </Grid>

                    </checkup:CollapsibleCheckupSection.SectionContent>

                </checkup:CollapsibleCheckupSection>

            </StackPanel>

            <!-- Rechte Spalte -->

            <StackPanel Grid.Column="2">

                <!-- Bewertung -->

                <checkup:CollapsibleCheckupSection
                    Title="Bewertung">

                    <checkup:CollapsibleCheckupSection.SectionContent>

                        <StackPanel>

                            <TextBlock
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Empfehlungen, Warnungen und kritische Befunde stehen im Vordergrund. Reine Informationsbefunde sind kompakt eingeklappt."
                                TextWrapping="Wrap" />

                            <Border
                                Margin="0,16,0,0"
                                Padding="12,9"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Foreground="{StaticResource AccentBrush}"
                                        Text="&#xE9D9;" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="{Binding Assessment.FindingsOverviewText}"
                                        TextWrapping="Wrap" />

                                </Grid>

                            </Border>

                            <Border
                                Margin="0,16,0,0"
                                Padding="14"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource SuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

                                <Border.Style>

                                    <Style TargetType="Border">

                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding Assessment.HasActionableFindings}"
                                                Value="False">

                                                <Setter
                                                    Property="Visibility"
                                                    Value="Visible" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Border.Style>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Top"
                                        FontSize="18"
                                        Foreground="{StaticResource SuccessBrush}"
                                        Text="✓" />

                                    <StackPanel Grid.Column="1">

                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="Kein unmittelbarer Handlungsbedarf erkannt"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="0,5,0,0"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="Die Bewertung enthält derzeit keine Empfehlung, Warnung oder kritische Auffälligkeit."
                                            TextWrapping="Wrap" />

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <ItemsControl
                                Margin="0,20,0,0"
                                ItemsSource="{Binding Assessment.ActionableFindings}">

                                <ItemsControl.Style>

                                    <Style TargetType="ItemsControl">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding Assessment.HasActionableFindings}"
                                                Value="False">

                                                <Setter
                                                    Property="Visibility"
                                                    Value="Collapsed" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </ItemsControl.Style>

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            Margin="0,0,0,12"
                                            Padding="14"
                                            Background="{StaticResource BackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Top"
                                                    FontSize="18"
                                                    Text="{Binding Severity, Converter={StaticResource FindingSeverityToSymbolConverter}}" />

                                                <StackPanel Grid.Column="1">

                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        Text="{Binding Title}"
                                                        TextWrapping="Wrap" />

                                                    <TextBlock
                                                        Margin="0,5,0,0"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Text="{Binding Description}"
                                                        TextWrapping="Wrap" />

                                                </StackPanel>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <Expander
                                Margin="0,4,0,0"
                                IsExpanded="False">

                                <Expander.Style>

                                    <Style TargetType="Expander">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding Assessment.HasInformationalFindings}"
                                                Value="False">

                                                <Setter
                                                    Property="Visibility"
                                                    Value="Collapsed" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Expander.Style>

                                <Expander.Header>

                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="{Binding Assessment.InformationalFindingsHeaderText}" />

                                </Expander.Header>

                                <ItemsControl
                                    Margin="0,10,0,0"
                                    ItemsSource="{Binding Assessment.InformationalFindings}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border
                                                Margin="0,0,0,6"
                                                Padding="10"
                                                Background="{StaticResource SurfaceSecondaryBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Top"
                                                        FontSize="14"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        Text="{Binding Severity, Converter={StaticResource FindingSeverityToSymbolConverter}}" />

                                                    <StackPanel Grid.Column="1">

                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource TextPrimaryBrush}"
                                                            Text="{Binding Title}"
                                                            TextWrapping="Wrap" />

                                                        <TextBlock
                                                            Margin="0,3,0,0"
                                                            FontSize="11"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            Text="{Binding Description}"
                                                            TextWrapping="Wrap" />

                                                    </StackPanel>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </Expander>

                        </StackPanel>

                    </checkup:CollapsibleCheckupSection.SectionContent>

                </checkup:CollapsibleCheckupSection>

            </StackPanel>

        </Grid>

        <checkup:RestartInformationCard
            Margin="0,24,0,0"
            DataContext="{Binding RestartInformation}" />

        <!--
            SCHRITT 47:
            Eigenständige Detailansicht für Windows Update.
            Die Daten stammen ausschließlich aus dem Scan.
            Es werden keine Updates installiert.
        -->

        <checkup:CollapsibleCheckupSection
            Margin="0,24,0,0"
            Title="Windows Update"
            DataContext="{Binding WindowsUpdateInformation}">

            <checkup:CollapsibleCheckupSection.SectionContent>

                <StackPanel>

                    <TextBlock
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Ergebnisse der Windows-Update-Onlineprüfung sowie ergänzende lokale Informationen zum Update-Dienst und Installationsverlauf."
                        TextWrapping="Wrap" />

                    <!-- Onlineprüfung -->

                    <Border
                        Margin="0,16,0,0"
                        Padding="14"
                        Background="{StaticResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel>

                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Onlineprüfung" />

                            <TextBlock
                                Margin="0,10,0,0"
                                FontWeight="SemiBold">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter
                                            Property="Text"
                                            Value="Onlineprüfung nicht durchgeführt" />

                                        <Setter
                                            Property="Foreground"
                                            Value="{StaticResource TextSecondaryBrush}" />

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding IsUpdateSearchPerformed}"
                                                Value="True">

                                                <Setter
                                                    Property="Text"
                                                    Value="Onlineprüfung nicht erfolgreich" />

                                                <Setter
                                                    Property="Foreground"
                                                    Value="{StaticResource WarningBrush}" />

                                            </DataTrigger>

                                            <MultiDataTrigger>

                                                <MultiDataTrigger.Conditions>

                                                    <Condition
                                                        Binding="{Binding IsUpdateSearchPerformed}"
                                                        Value="True" />

                                                    <Condition
                                                        Binding="{Binding IsUpdateSearchSuccessful}"
                                                        Value="True" />

                                                </MultiDataTrigger.Conditions>

                                                <Setter
                                                    Property="Text"
                                                    Value="Onlineprüfung erfolgreich" />

                                                <Setter
                                                    Property="Foreground"
                                                    Value="{StaticResource SuccessBrush}" />

                                            </MultiDataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                            <StackPanel
                                Margin="0,9,0,0"
                                Orientation="Horizontal">

                                <TextBlock
                                    Margin="0,0,12,0"
                                    FontWeight="SemiBold"
                                    Text="Suchzeitpunkt:" />

                                <TextBlock
                                    Text="{Binding UpdateSearchDate, StringFormat={}{0:dd.MM.yyyy HH:mm}, TargetNullValue=Nicht verfügbar}" />

                            </StackPanel>

                            <TextBlock
                                Margin="0,10,0,0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding UpdateSearchDetails}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>

                    <!-- Ausstehende Updates -->

                    <TextBlock
                        Margin="0,24,0,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Ausstehende Aktualisierungen" />

                    <TextBlock
                        Margin="0,5,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Angezeigt werden die bei der Onlineprüfung erkannten, noch nicht installierten Updates. Der Checkup installiert sie nicht automatisch."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding PendingUpdates.Count, StringFormat=Erkannte Updates: {0}}" />

                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Ohne erfolgreich abgeschlossene Onlineprüfung ist keine verlässliche Aussage über die Zahl ausstehender Updates möglich."
                        TextWrapping="Wrap">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />

                                <Style.Triggers>

                                    <MultiDataTrigger>

                                        <MultiDataTrigger.Conditions>

                                            <Condition
                                                Binding="{Binding IsUpdateSearchPerformed}"
                                                Value="True" />

                                            <Condition
                                                Binding="{Binding IsUpdateSearchSuccessful}"
                                                Value="True" />

                                        </MultiDataTrigger.Conditions>

                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />

                                    </MultiDataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="{StaticResource SuccessBrush}"
                        Text="Die erfolgreiche Onlineprüfung hat keine ausstehenden, regulär zugewiesenen Updates erkannt."
                        TextWrapping="Wrap">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />

                                <Style.Triggers>

                                    <MultiDataTrigger>

                                        <MultiDataTrigger.Conditions>

                                            <Condition
                                                Binding="{Binding IsUpdateSearchPerformed}"
                                                Value="True" />

                                            <Condition
                                                Binding="{Binding IsUpdateSearchSuccessful}"
                                                Value="True" />

                                            <Condition
                                                Binding="{Binding PendingUpdates.Count}"
                                                Value="0" />

                                        </MultiDataTrigger.Conditions>

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />

                                    </MultiDataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                    <ItemsControl
                        Margin="0,12,0,0"
                        ItemsSource="{Binding PendingUpdates}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Margin="0,0,0,8"
                                    Padding="14,12"
                                    Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                    <StackPanel>

                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="{Binding Category, StringFormat=Kategorie: {0}}" />

                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="{Binding MsrcSeverity, StringFormat=MSRC-Einstufung: {0}}" />

                                        <TextBlock
                                            Margin="0,5,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource WarningBrush}"
                                            Text="Neustart laut Updatedaten erforderlich">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding RequiresRestart}"
                                                            Value="True">

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                        <TextBlock
                                            Margin="0,5,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="KB-Referenzen:" />

                                        <ItemsControl
                                            Margin="0,3,0,0"
                                            ItemsSource="{Binding KbArticleIds}">

                                            <ItemsControl.ItemsPanel>

                                                <ItemsPanelTemplate>

                                                    <WrapPanel />

                                                </ItemsPanelTemplate>

                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <TextBlock
                                                        Margin="0,0,12,4"
                                                        FontSize="11"
                                                        Foreground="{StaticResource AccentBrush}"
                                                        Text="{Binding StringFormat=KB{0}}" />

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <!-- Windows-Update-Dienst -->

                    <TextBlock
                        Margin="0,22,0,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Windows-Update-Dienst" />

                    <Border
                        Margin="0,10,0,0"
                        Padding="14"
                        Background="{StaticResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Margin="0,0,12,0"
                                    FontWeight="SemiBold"
                                    Text="Dienstzustand:" />

                                <TextBlock>

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter
                                                Property="Text"
                                                Value="Unbekannt" />

                                            <Setter
                                                Property="Foreground"
                                                Value="{StaticResource TextSecondaryBrush}" />

                                            <Style.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding ServiceState}"
                                                    Value="{x:Static models:WindowsUpdateServiceState.Running}">

                                                    <Setter
                                                        Property="Text"
                                                        Value="Gestartet" />

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{StaticResource SuccessBrush}" />

                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding ServiceState}"
                                                    Value="{x:Static models:WindowsUpdateServiceState.Stopped}">

                                                    <Setter
                                                        Property="Text"
                                                        Value="Beendet" />

                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding ServiceState}"
                                                    Value="{x:Static models:WindowsUpdateServiceState.Disabled}">

                                                    <Setter
                                                        Property="Text"
                                                        Value="Deaktiviert" />

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{StaticResource WarningBrush}" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </StackPanel>

                            <StackPanel
                                Margin="0,8,0,0"
                                Orientation="Horizontal">

                                <TextBlock
                                    Margin="0,0,12,0"
                                    FontWeight="SemiBold"
                                    Text="Startkonfiguration:" />

                                <TextBlock
                                    Text="{Binding ServiceStartMode}"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                            <TextBlock
                                Margin="0,10,0,0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding ServiceStatusDetails}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>

                    <!-- Updateverlauf -->

                    <TextBlock
                        Margin="0,24,0,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Updateverlauf" />

                    <StackPanel
                        Margin="0,10,0,0"
                        Orientation="Horizontal">

                        <TextBlock
                            Margin="0,0,12,0"
                            FontWeight="SemiBold"
                            Text="Letzte erfolgreiche Installation:" />

                        <TextBlock
                            Text="{Binding LastSuccessfulInstallationDate, StringFormat={}{0:dd.MM.yyyy HH:mm}, TargetNullValue=Nicht ermittelt}" />

                    </StackPanel>

                    <TextBlock
                        Margin="0,18,0,0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Kürzlich fehlgeschlagene Installationen" />

                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Die folgenden Einträge stammen aus dem lokal verfügbaren Updateverlauf. Sie bedeuten nicht automatisch, dass das Update weiterhin fehlt."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Keine relevanten fehlgeschlagenen Installationen im ausgewerteten Verlauf erfasst.">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding RecentFailures.Count}"
                                        Value="0">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                    <ItemsControl
                        Margin="0,12,0,0"
                        ItemsSource="{Binding RecentFailures}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    Background="{StaticResource SurfaceSecondaryBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">

                                    <StackPanel>

                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}, TargetNullValue=Zeitpunkt nicht verfügbar}" />

                                        <TextBlock
                                            Margin="0,3,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource WarningBrush}"
                                            Text="{Binding ErrorCodeHex, StringFormat=Fehlercode: {0}}" />

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </checkup:CollapsibleCheckupSection.SectionContent>

        </checkup:CollapsibleCheckupSection>

        <checkup:CleanupPotentialCard
            Margin="0,24,0,0"
            DataContext="{Binding CleanupPotentialInformation}" />

        <checkup:StartupInformationCard
            Margin="0,24,0,0"
            DataContext="{Binding StartupInformation}" />

        <checkup:DeviceDriverInformationCard
            Margin="0,24,0,0"
            DataContext="{Binding DeviceDriverInformation}" />

    </StackPanel>

</UserControl>
