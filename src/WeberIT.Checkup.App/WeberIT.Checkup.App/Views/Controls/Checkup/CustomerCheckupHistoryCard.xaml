<UserControl
    x:Class="WeberIT.Checkup.App.Views.Controls.Checkup.CustomerCheckupHistoryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:checkup="clr-namespace:WeberIT.Checkup.App.Views.Controls.Checkup">

    <UserControl.Style>

        <Style TargetType="UserControl">

            <Setter
                Property="Visibility"
                Value="Collapsed" />

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding HasCustomerCheckupHistory}"
                    Value="True">

                    <Setter
                        Property="Visibility"
                        Value="Visible" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Style>

    <checkup:CollapsibleCheckupSection
        Title="{Binding CustomerCheckupHistoryTitle}">

        <checkup:CollapsibleCheckupSection.SectionContent>

            <StackPanel>

                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Vergangene Kundencheckups dieses Geräts. Die Einträge sind rein lesend und zeigen den dokumentierten Stand des jeweiligen Vorgangs."
                    TextWrapping="Wrap" />

                <ItemsControl
                    Margin="0,18,0,0"
                    ItemsSource="{Binding CustomerCheckupHistory}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="0,0,0,12"
                                Padding="14"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

                                <Expander
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False">

                                    <Expander.Header>

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    Text="{Binding StartedAtText}" />

                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="{Binding CompletedAtText}" />

                                            </StackPanel>

                                            <Border
                                                Grid.Column="1"
                                                Margin="18,0,0,0"
                                                Padding="9,5"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource SurfaceSecondaryBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">

                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding StatusText}">

                                                    <TextBlock.Style>

                                                        <Style TargetType="TextBlock">

                                                            <Setter
                                                                Property="Foreground"
                                                                Value="{StaticResource SuccessBrush}" />

                                                            <Style.Triggers>

                                                                <DataTrigger
                                                                    Binding="{Binding IsCancelled}"
                                                                    Value="True">

                                                                    <Setter
                                                                        Property="Foreground"
                                                                        Value="{StaticResource WarningBrush}" />

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </TextBlock.Style>

                                                </TextBlock>

                                            </Border>

                                        </Grid>

                                    </Expander.Header>

                                    <StackPanel Margin="0,16,0,0">

                                        <!-- Technischer Vergleich -->

                                        <Border
                                            Padding="14"
                                            Background="{StaticResource SurfaceSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">

                                            <Border.Style>

                                                <Style TargetType="Border">

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding HasComparison}"
                                                            Value="True">

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Border.Style>

                                            <StackPanel>

                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="TECHNISCHER VERGLEICH" />

                                                <Grid Margin="0,12,0,0">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Systemscore -->

                                                    <Border
                                                        Grid.Column="0"
                                                        Padding="12"
                                                        Background="{StaticResource BackgroundBrush}"
                                                        CornerRadius="6">

                                                        <StackPanel>

                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="{StaticResource TextMutedBrush}"
                                                                Text="SYSTEMSCORE" />

                                                            <StackPanel
                                                                Margin="0,6,0,0"
                                                                Orientation="Horizontal">

                                                                <TextBlock
                                                                    FontSize="16"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                                    Text="{Binding Comparison.SystemScore.BeforeScore, TargetNullValue=–}" />

                                                                <TextBlock
                                                                    Margin="6,0"
                                                                    FontSize="16"
                                                                    Foreground="{StaticResource TextMutedBrush}"
                                                                    Text="→" />

                                                                <TextBlock
                                                                    FontSize="16"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource AccentBrush}"
                                                                    Text="{Binding Comparison.SystemScore.AfterScore, TargetNullValue=–}" />

                                                            </StackPanel>

                                                        </StackPanel>

                                                    </Border>

                                                    <!-- Hardwarescore -->

                                                    <Border
                                                        Grid.Column="2"
                                                        Padding="12"
                                                        Background="{StaticResource BackgroundBrush}"
                                                        CornerRadius="6">

                                                        <StackPanel>

                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="{StaticResource TextMutedBrush}"
                                                                Text="HARDWARESCORE" />

                                                            <StackPanel
                                                                Margin="0,6,0,0"
                                                                Orientation="Horizontal">

                                                                <TextBlock
                                                                    FontSize="16"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                                    Text="{Binding Comparison.HardwareScore.BeforeScore, TargetNullValue=–}" />

                                                                <TextBlock
                                                                    Margin="6,0"
                                                                    FontSize="16"
                                                                    Foreground="{StaticResource TextMutedBrush}"
                                                                    Text="→" />

                                                                <TextBlock
                                                                    FontSize="16"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource AccentBrush}"
                                                                    Text="{Binding Comparison.HardwareScore.AfterScore, TargetNullValue=–}" />

                                                            </StackPanel>

                                                        </StackPanel>

                                                    </Border>

                                                    <!-- Behobene Befunde -->

                                                    <Border
                                                        Grid.Column="4"
                                                        Padding="12"
                                                        Background="{StaticResource BackgroundBrush}"
                                                        CornerRadius="6">

                                                        <StackPanel>

                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="{StaticResource TextMutedBrush}"
                                                                Text="BEHOBENE BEFUNDE" />

                                                            <TextBlock
                                                                Margin="0,6,0,0"
                                                                FontSize="16"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource SuccessBrush}"
                                                                Text="{Binding Comparison.ResolvedFindingCount}" />

                                                        </StackPanel>

                                                    </Border>

                                                    <!-- Restbefunde -->

                                                    <Border
                                                        Grid.Column="6"
                                                        Padding="12"
                                                        Background="{StaticResource BackgroundBrush}"
                                                        CornerRadius="6">

                                                        <StackPanel>

                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="{StaticResource TextMutedBrush}"
                                                                Text="VERBLEIBEND / NEU" />

                                                            <StackPanel
                                                                Margin="0,6,0,0"
                                                                Orientation="Horizontal">

                                                                <TextBlock
                                                                    FontSize="16"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource WarningBrush}"
                                                                    Text="{Binding Comparison.StillOpenFindingCount}" />

                                                                <TextBlock
                                                                    Margin="6,0"
                                                                    FontSize="13"
                                                                    Foreground="{StaticResource TextMutedBrush}"
                                                                    Text="+"/>

                                                                <TextBlock
                                                                    FontSize="16"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource WarningBrush}"
                                                                    Text="{Binding Comparison.NewlyDetectedFindingCount}" />

                                                            </StackPanel>

                                                        </StackPanel>

                                                    </Border>

                                                </Grid>

                                            </StackPanel>

                                        </Border>

                                        <!-- Technikerangaben -->

                                        <Border
                                            Margin="0,12,0,0"
                                            Padding="14"
                                            Background="{StaticResource SurfaceSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">

                                            <Border.Style>

                                                <Style TargetType="Border">

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding IsCompleted}"
                                                            Value="True">

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Border.Style>

                                            <StackPanel>

                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="TECHNIKERZUSAMMENFASSUNG" />

                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    Text="{Binding TechnicianSummary}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    Margin="0,16,0,0"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="NÄCHSTE SCHRITTE" />

                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    Text="{Binding NextSteps}"
                                                    TextWrapping="Wrap" />

                                                <Grid Margin="0,16,0,0">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Text="Nächster Checkup:" />

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Foreground="{StaticResource AccentBrush}"
                                                        Text="{Binding NextCheckupDateText}" />

                                                </Grid>

                                            </StackPanel>

                                        </Border>

                                        <!-- Abbruch -->

                                        <Border
                                            Margin="0,12,0,0"
                                            Padding="14"
                                            Background="{StaticResource SurfaceSecondaryBrush}"
                                            BorderBrush="{StaticResource WarningBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">

                                            <Border.Style>

                                                <Style TargetType="Border">

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding IsCancelled}"
                                                            Value="True">

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Border.Style>

                                            <StackPanel>

                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource WarningBrush}"
                                                    Text="ABBRUCHGRUND" />

                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    Text="{Binding CancellationReason}"
                                                    TextWrapping="Wrap" />

                                            </StackPanel>

                                        </Border>

                                    </StackPanel>

                                </Expander>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </checkup:CollapsibleCheckupSection.SectionContent>

    </checkup:CollapsibleCheckupSection>

</UserControl>