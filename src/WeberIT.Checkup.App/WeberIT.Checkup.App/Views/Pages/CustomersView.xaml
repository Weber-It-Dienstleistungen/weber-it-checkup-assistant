<UserControl
    x:Class="WeberIT.Checkup.App.Views.Pages.CustomersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WeberIT.Checkup.App.Views.Controls"
    xmlns:models="clr-namespace:WeberIT.Checkup.App.Models">

    <Grid>

        <!--
            Die normale Kundenverwaltung wird während eines
            Kundenscans vollständig deaktiviert. Dadurch kann
            weder per Maus noch per Tastatur der aktive Kunde
            oder das aktive Gerät gewechselt werden.
        -->

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Background="{StaticResource BackgroundBrush}">

            <ScrollViewer.Style>

                <Style TargetType="ScrollViewer">

                    <Setter
                        Property="IsEnabled"
                        Value="True" />

                    <Style.Triggers>

                        <DataTrigger
                            Binding="{Binding CustomerDevices.IsScanRunning}"
                            Value="True">

                            <Setter
                                Property="IsEnabled"
                                Value="False" />

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </ScrollViewer.Style>

            <Grid Margin="40,32,40,40">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Text="Kundenverwaltung"
                            Style="{StaticResource PageTitleTextStyle}" />

                        <TextBlock
                            Margin="0,6,0,0"
                            Text="Kundendaten verwalten, zugeordnete Geräte prüfen und neue Systemchecks durchführen."
                            Style="{StaticResource PageSubtitleTextStyle}" />

                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Width="150"
                        Height="40"
                        VerticalAlignment="Center"
                        Content="Neuer Kunde"
                        Command="{Binding AddCustomerCommand}"
                        Style="{StaticResource AccentButtonStyle}" />

                </Grid>

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Style="{StaticResource PanelCardStyle}"
                        Padding="20">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">

                                <TextBlock
                                    Text="Kunden"
                                    Style="{StaticResource SectionTitleTextStyle}" />

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="Wählen Sie einen Kunden aus der Liste aus." />

                            </StackPanel>

                            <Border
                                Grid.Row="2"
                                Height="42"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="16"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="&#xE721;" />

                                    <TextBox
                                        Grid.Column="1"
                                        Padding="0"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                </Grid>

                            </Border>

                            <Grid Grid.Row="4">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="Noch keine Kunden vorhanden."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter
                                                Property="Visibility"
                                                Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding Customers.Count}"
                                                    Value="0">

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                                <ListBox
                                    ItemsSource="{Binding CustomersView}"
                                    SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                                    <ListBox.ItemContainerStyle>

                                        <Style
                                            TargetType="ListBoxItem"
                                            BasedOn="{StaticResource {x:Type ListBoxItem}}">

                                            <Setter
                                                Property="Margin"
                                                Value="0,0,0,10" />

                                        </Style>

                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>

                                        <DataTemplate>

                                            <Border
                                                Padding="14"
                                                Background="{StaticResource SurfaceSecondaryBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Grid.Column="0"
                                                        Width="34"
                                                        Height="34"
                                                        VerticalAlignment="Top"
                                                        Background="{StaticResource BackgroundBrush}"
                                                        CornerRadius="17">

                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="15"
                                                            Foreground="{StaticResource AccentBrush}"
                                                            Text="&#xE77B;" />

                                                    </Border>

                                                    <StackPanel Grid.Column="1">

                                                        <TextBlock
                                                            FontSize="15"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource TextPrimaryBrush}"
                                                            Text="{Binding DisplayName}"
                                                            TextTrimming="CharacterEllipsis" />

                                                        <TextBlock
                                                            Margin="0,4,0,0"
                                                            FontSize="12"
                                                            Foreground="{StaticResource TextSecondaryBrush}">

                                                            <TextBlock.Text>

                                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                                    <Binding Path="CustomerNumber" />
                                                                    <Binding Path="City" />
                                                                </MultiBinding>

                                                            </TextBlock.Text>

                                                        </TextBlock>

                                                        <TextBlock
                                                            Margin="0,4,0,0"
                                                            FontSize="11"
                                                            Foreground="{StaticResource TextMutedBrush}">

                                                            <TextBlock.Text>

                                                                <MultiBinding StringFormat="{}{0} Geräte gespeichert">
                                                                    <Binding Path="Devices.Count" />
                                                                </MultiBinding>

                                                            </TextBlock.Text>

                                                        </TextBlock>

                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        Text="&#xE76C;" />

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ListBox.ItemTemplate>

                                </ListBox>

                            </Grid>

                        </Grid>

                    </Border>

                    <Grid Grid.Column="2">

                        <Border>

                            <Border.Style>

                                <Style
                                    TargetType="Border"
                                    BasedOn="{StaticResource PanelCardStyle}">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding SelectedCustomer}"
                                            Value="{x:Null}">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420">

                                <Border
                                    Width="64"
                                    Height="64"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource SurfaceSecondaryBrush}"
                                    CornerRadius="32">

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="25"
                                        Foreground="{StaticResource AccentBrush}"
                                        Text="&#xE716;" />

                                </Border>

                                <TextBlock
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="Kein Kunde ausgewählt" />

                                <TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="Wählen Sie links einen Kunden aus oder legen Sie einen neuen Kunden an."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </Border>

                        <StackPanel>

                            <StackPanel.Style>

                                <Style TargetType="StackPanel">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding SelectedCustomer}"
                                            Value="{x:Null}">

                                            <Setter
                                                Property="Visibility"
                                                Value="Collapsed" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </StackPanel.Style>

                            <Border
                                Style="{StaticResource PanelCardStyle}"
                                Padding="24">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock
                                                Text="Kundendetails"
                                                Style="{StaticResource SectionTitleTextStyle}" />

                                            <TextBlock
                                                Margin="0,5,0,0"
                                                FontSize="17"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Text="{Binding SelectedCustomer.DisplayName}" />

                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            Width="125"
                                            VerticalAlignment="Center"
                                            Content="Bearbeiten"
                                            Command="{Binding EditCustomerCommand}" />

                                        <Button
                                            Grid.Column="3"
                                            Width="110"
                                            VerticalAlignment="Center"
                                            Content="Löschen"
                                            Command="{Binding DeleteCustomerCommand}"
                                            Foreground="{StaticResource DangerBrush}" />

                                    </Grid>

                                    <Grid Grid.Row="2">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock
                                                Text="Kundennummer"
                                                Style="{StaticResource CardTitleTextStyle}" />

                                            <TextBlock
                                                Margin="0,5,0,18"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding SelectedCustomer.CustomerNumber}" />

                                            <TextBlock
                                                Text="E-Mail"
                                                Style="{StaticResource CardTitleTextStyle}" />

                                            <TextBlock
                                                Margin="0,5,0,18"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding SelectedCustomer.Email}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Text="Telefon"
                                                Style="{StaticResource CardTitleTextStyle}" />

                                            <TextBlock
                                                Margin="0,5,0,0"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding SelectedCustomer.Phone}" />

                                        </StackPanel>

                                        <Border
                                            Grid.Column="1"
                                            Width="1"
                                            HorizontalAlignment="Center"
                                            Background="{StaticResource BorderBrush}" />

                                        <StackPanel Grid.Column="2">

                                            <TextBlock
                                                Text="Adresse"
                                                Style="{StaticResource CardTitleTextStyle}" />

                                            <TextBlock
                                                Margin="0,5,0,0"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding SelectedCustomer.Street}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="14"
                                                FontWeight="SemiBold">

                                                <TextBlock.Text>

                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="SelectedCustomer.PostalCode" />
                                                        <Binding Path="SelectedCustomer.City" />
                                                    </MultiBinding>

                                                </TextBlock.Text>

                                            </TextBlock>

                                            <TextBlock
                                                Margin="0,22,0,0"
                                                Text="Kunde seit"
                                                Style="{StaticResource CardTitleTextStyle}" />

                                            <TextBlock
                                                Margin="0,5,0,0"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding SelectedCustomer.CreatedAt, StringFormat={}{0:dd.MM.yyyy}}" />

                                        </StackPanel>

                                    </Grid>

                                </Grid>

                            </Border>

                            <controls:CustomerDevicesView
                                Margin="0,20,0,0"
                                DataContext="{Binding CustomerDevices}" />

                        </StackPanel>

                    </Grid>

                </Grid>

            </Grid>

        </ScrollViewer>

        <!--
            Scan-Overlay über der gesamten Kundenverwaltung.
            Es wird nur während eines aktiven Systemscans sichtbar.
        -->

        <Grid
            Panel.ZIndex="100"
            Background="{StaticResource BackgroundBrush}">

            <Grid.Style>

                <Style TargetType="Grid">

                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />

                    <Style.Triggers>

                        <DataTrigger
                            Binding="{Binding CustomerDevices.IsScanRunning}"
                            Value="True">

                            <Setter
                                Property="Visibility"
                                Value="Visible" />

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Grid.Style>

            <Border
                Margin="40"
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="900"
                MaxHeight="760"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">

                        <StackPanel Orientation="Horizontal">

                            <Border
                                Width="44"
                                Height="44"
                                Margin="0,0,14,0"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                CornerRadius="10">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="20"
                                    Foreground="{StaticResource AccentBrush}"
                                    Text="&#xE895;" />

                            </Border>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock
                                    FontSize="21"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding CustomerDevices.ScanContextTitle}" />

                                <TextBlock
                                    Margin="0,4,0,0"
                                    MaxWidth="760"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{Binding CustomerDevices.ScanContextDescription}"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </StackPanel>

                    </StackPanel>

                    <Border
                        Grid.Row="2"
                        Padding="18"
                        Background="{StaticResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">

                        <StackPanel>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="{Binding CustomerDevices.ScanProgressTitle}" />

                                    <TextBlock
                                        Margin="0,5,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="{Binding CustomerDevices.ScanProgressSummaryText}" />

                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="24,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentBrush}"
                                    Text="{Binding CustomerDevices.ScanProgressPercentageText}" />

                            </Grid>

                            <ProgressBar
                                Height="12"
                                Margin="0,17,0,0"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding CustomerDevices.ScanProgressPercentage, Mode=OneWay}"
                                Background="{StaticResource BackgroundBrush}"
                                BorderThickness="0"
                                Foreground="{StaticResource AccentBrush}" />

                            <Border
                                Margin="0,15,0,0"
                                Padding="13,10"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="15"
                                        Foreground="{StaticResource AccentBrush}"
                                        Text="&#xE895;" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="{Binding CustomerDevices.ScanCurrentStepText}"
                                        TextWrapping="Wrap" />

                                </Grid>

                            </Border>

                        </StackPanel>

                    </Border>

                    <Border
                        Grid.Row="4"
                        Padding="16"
                        Background="{StaticResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">

                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="Scanbereiche" />

                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="Die Kunden- und Geräteauswahl bleibt bis zum vollständigen Ende des Scans gesperrt."
                                    TextWrapping="Wrap" />

                            </StackPanel>

                            <ScrollViewer
                                Grid.Row="2"
                                MaxHeight="360"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">

                                <ItemsControl
                                    ItemsSource="{Binding CustomerDevices.ScanSteps}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="12,10"
                                                CornerRadius="7">

                                                <Border.Style>

                                                    <Style TargetType="Border">

                                                        <Setter
                                                            Property="Background"
                                                            Value="{StaticResource BackgroundBrush}" />

                                                        <Setter
                                                            Property="BorderBrush"
                                                            Value="{StaticResource BorderBrush}" />

                                                        <Setter
                                                            Property="BorderThickness"
                                                            Value="1" />

                                                        <Style.Triggers>

                                                            <DataTrigger
                                                                Binding="{Binding Status}"
                                                                Value="{x:Static models:CheckupScanStepStatus.Running}">

                                                                <Setter
                                                                    Property="BorderBrush"
                                                                    Value="{StaticResource AccentBrush}" />

                                                            </DataTrigger>

                                                            <DataTrigger
                                                                Binding="{Binding Status}"
                                                                Value="{x:Static models:CheckupScanStepStatus.Successful}">

                                                                <Setter
                                                                    Property="BorderBrush"
                                                                    Value="{StaticResource SuccessBrush}" />

                                                            </DataTrigger>

                                                            <DataTrigger
                                                                Binding="{Binding Status}"
                                                                Value="{x:Static models:CheckupScanStepStatus.Warning}">

                                                                <Setter
                                                                    Property="BorderBrush"
                                                                    Value="{StaticResource WarningBrush}" />

                                                            </DataTrigger>

                                                            <DataTrigger
                                                                Binding="{Binding Status}"
                                                                Value="{x:Static models:CheckupScanStepStatus.Failed}">

                                                                <Setter
                                                                    Property="BorderBrush"
                                                                    Value="{StaticResource DangerBrush}" />

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Border.Style>

                                                <Grid>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="210" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="17"
                                                        TextAlignment="Center">

                                                        <TextBlock.Style>

                                                            <Style TargetType="TextBlock">

                                                                <Setter
                                                                    Property="Text"
                                                                    Value="○" />

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource TextMutedBrush}" />

                                                                <Style.Triggers>

                                                                    <DataTrigger
                                                                        Binding="{Binding Status}"
                                                                        Value="{x:Static models:CheckupScanStepStatus.Running}">

                                                                        <Setter
                                                                            Property="Text"
                                                                            Value="●" />

                                                                        <Setter
                                                                            Property="Foreground"
                                                                            Value="{StaticResource AccentBrush}" />

                                                                    </DataTrigger>

                                                                    <DataTrigger
                                                                        Binding="{Binding Status}"
                                                                        Value="{x:Static models:CheckupScanStepStatus.Successful}">

                                                                        <Setter
                                                                            Property="Text"
                                                                            Value="✓" />

                                                                        <Setter
                                                                            Property="Foreground"
                                                                            Value="{StaticResource SuccessBrush}" />

                                                                    </DataTrigger>

                                                                    <DataTrigger
                                                                        Binding="{Binding Status}"
                                                                        Value="{x:Static models:CheckupScanStepStatus.Warning}">

                                                                        <Setter
                                                                            Property="Text"
                                                                            Value="⚠" />

                                                                        <Setter
                                                                            Property="Foreground"
                                                                            Value="{StaticResource WarningBrush}" />

                                                                    </DataTrigger>

                                                                    <DataTrigger
                                                                        Binding="{Binding Status}"
                                                                        Value="{x:Static models:CheckupScanStepStatus.Failed}">

                                                                        <Setter
                                                                            Property="Text"
                                                                            Value="✕" />

                                                                        <Setter
                                                                            Property="Foreground"
                                                                            Value="{StaticResource DangerBrush}" />

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </TextBlock.Style>

                                                    </TextBlock>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="0,0,18,0"
                                                        VerticalAlignment="Center">

                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource TextPrimaryBrush}"
                                                            Text="{Binding StepTitle}"
                                                            TextWrapping="Wrap" />

                                                        <TextBlock
                                                            Margin="0,3,0,0"
                                                            FontSize="10"
                                                            Text="{Binding StatusText}">

                                                            <TextBlock.Style>

                                                                <Style TargetType="TextBlock">

                                                                    <Setter
                                                                        Property="Foreground"
                                                                        Value="{StaticResource TextMutedBrush}" />

                                                                    <Style.Triggers>

                                                                        <DataTrigger
                                                                            Binding="{Binding Status}"
                                                                            Value="{x:Static models:CheckupScanStepStatus.Running}">

                                                                            <Setter
                                                                                Property="Foreground"
                                                                                Value="{StaticResource AccentBrush}" />

                                                                        </DataTrigger>

                                                                        <DataTrigger
                                                                            Binding="{Binding Status}"
                                                                            Value="{x:Static models:CheckupScanStepStatus.Successful}">

                                                                            <Setter
                                                                                Property="Foreground"
                                                                                Value="{StaticResource SuccessBrush}" />

                                                                        </DataTrigger>

                                                                        <DataTrigger
                                                                            Binding="{Binding Status}"
                                                                            Value="{x:Static models:CheckupScanStepStatus.Warning}">

                                                                            <Setter
                                                                                Property="Foreground"
                                                                                Value="{StaticResource WarningBrush}" />

                                                                        </DataTrigger>

                                                                        <DataTrigger
                                                                            Binding="{Binding Status}"
                                                                            Value="{x:Static models:CheckupScanStepStatus.Failed}">

                                                                            <Setter
                                                                                Property="Foreground"
                                                                                Value="{StaticResource DangerBrush}" />

                                                                        </DataTrigger>

                                                                    </Style.Triggers>

                                                                </Style>

                                                            </TextBlock.Style>

                                                        </TextBlock>

                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Text="{Binding DisplayMessage}"
                                                        TextWrapping="Wrap" />

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>