<Window
    x:Class="WeberIT.Checkup.App.Views.Dialogs.CustomerCheckupCompletionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:WeberIT.Checkup.App.Models"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    Title="Kundencheckup vorbereiten"
    Width="1080"
    Height="820"
    MinWidth="900"
    MinHeight="680"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}">

    <Window.Resources>

        <Style
            x:Key="CustomerCheckupCalendarDayButtonStyle"
            TargetType="{x:Type primitives:CalendarDayButton}">

            <Setter
                Property="Foreground"
                Value="{StaticResource PrimaryBrush}" />

            <Setter
                Property="Background"
                Value="White" />

            <Setter
                Property="BorderBrush"
                Value="Transparent" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="Padding"
                Value="4" />

            <Setter
                Property="HorizontalContentAlignment"
                Value="Center" />

            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />

            <Style.Triggers>

                <Trigger
                    Property="IsInactive"
                    Value="True">

                    <Setter
                        Property="Foreground"
                        Value="#64748B" />

                </Trigger>

                <Trigger
                    Property="IsToday"
                    Value="True">

                    <Setter
                        Property="BorderBrush"
                        Value="{StaticResource AccentBrush}" />

                </Trigger>

                <Trigger
                    Property="IsMouseOver"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="#E2E8F0" />

                    <Setter
                        Property="Foreground"
                        Value="{StaticResource PrimaryBrush}" />

                </Trigger>

                <Trigger
                    Property="IsSelected"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="{StaticResource AccentBrush}" />

                    <Setter
                        Property="Foreground"
                        Value="White" />

                    <Setter
                        Property="BorderBrush"
                        Value="{StaticResource AccentBrush}" />

                </Trigger>

                <Trigger
                    Property="IsEnabled"
                    Value="False">

                    <Setter
                        Property="Foreground"
                        Value="#94A3B8" />

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style
            x:Key="CustomerCheckupCalendarButtonStyle"
            TargetType="{x:Type primitives:CalendarButton}">

            <Setter
                Property="Foreground"
                Value="{StaticResource PrimaryBrush}" />

            <Setter
                Property="Background"
                Value="White" />

            <Setter
                Property="BorderBrush"
                Value="Transparent" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="Margin"
                Value="2" />

            <Setter
                Property="Padding"
                Value="6" />

            <Setter
                Property="HorizontalContentAlignment"
                Value="Center" />

            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />

            <Style.Triggers>

                <Trigger
                    Property="IsMouseOver"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="#E2E8F0" />

                    <Setter
                        Property="Foreground"
                        Value="{StaticResource PrimaryBrush}" />

                </Trigger>

                <Trigger
                    Property="IsEnabled"
                    Value="False">

                    <Setter
                        Property="Foreground"
                        Value="#94A3B8" />

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style
            x:Key="CustomerCheckupCalendarItemStyle"
            TargetType="{x:Type primitives:CalendarItem}">

            <Setter
                Property="Background"
                Value="White" />

            <Setter
                Property="Foreground"
                Value="{StaticResource PrimaryBrush}" />

            <Setter
                Property="BorderBrush"
                Value="#CBD5E1" />

            <Setter
                Property="BorderThickness"
                Value="1" />

        </Style>

        <Style
            x:Key="CustomerCheckupCalendarStyle"
            TargetType="{x:Type Calendar}">

            <Setter
                Property="Background"
                Value="White" />

            <Setter
                Property="Foreground"
                Value="{StaticResource PrimaryBrush}" />

            <Setter
                Property="BorderBrush"
                Value="#CBD5E1" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="CalendarItemStyle"
                Value="{StaticResource CustomerCheckupCalendarItemStyle}" />

            <Setter
                Property="CalendarDayButtonStyle"
                Value="{StaticResource CustomerCheckupCalendarDayButtonStyle}" />

            <Setter
                Property="CalendarButtonStyle"
                Value="{StaticResource CustomerCheckupCalendarButtonStyle}" />

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="28,22"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="42"
                    Height="42"
                    VerticalAlignment="Top"
                    Background="{StaticResource SurfaceSecondaryBrush}"
                    CornerRadius="10">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="19"
                        Foreground="{StaticResource AccentBrush}"
                        Text="&#xE9D2;" />

                </Border>

                <StackPanel Grid.Column="1">

                    <TextBlock
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Kundencheckup vorbereiten" />

                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        TextWrapping="Wrap">

                        <Run Text="Gerät: " />

                        <Run
                            FontWeight="SemiBold"
                            Text="{Binding DeviceDisplayName, Mode=OneWay}" />

                        <Run Text=" · Vergleich prüfen und Technikerangaben erfassen." />

                    </TextBlock>

                </StackPanel>

            </Grid>

        </Border>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="28,22">

                <Border
                    Padding="14"
                    Background="{StaticResource SurfaceSecondaryBrush}"
                    BorderBrush="{StaticResource InformationBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Foreground="{StaticResource InformationBrush}"
                            Text="&#xE946;" />

                        <TextBlock
                            Grid.Column="1"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Dieser Schritt speichert nur einen Abschlussentwurf. Der Kundencheckup bleibt in Bearbeitung und wird noch nicht endgültig abgeschlossen."
                            TextWrapping="Wrap" />

                    </Grid>

                </Border>

                <Border
                    Margin="0,18,0,0"
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">

                    <StackPanel>

                        <TextBlock
                            Text="Vergleich auf einen Blick"
                            Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBlock
                            Margin="0,4,0,16"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap">

                            <Run Text="Eingangsscan: " />

                            <Run
                                Text="{Binding BeforeScanDateText, Mode=OneWay}" />

                            <Run Text=" · Nachher-Scan: " />

                            <Run
                                Text="{Binding AfterScanDateText, Mode=OneWay}" />

                        </TextBlock>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Padding="14"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                BorderBrush="{StaticResource SuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

                                <StackPanel>

                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource SuccessBrush}"
                                        Text="{Binding ResolvedFindingCountText, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Behoben" />

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Column="2"
                                Padding="14"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                BorderBrush="{StaticResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

                                <StackPanel>

                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource WarningBrush}"
                                        Text="{Binding StillOpenFindingCountText, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Weiterhin offen" />

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Column="4"
                                Padding="14"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

                                <StackPanel>

                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DangerBrush}"
                                        Text="{Binding NewlyDetectedFindingCountText, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Neu erkannt" />

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Column="6"
                                Padding="14"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                BorderBrush="{StaticResource InformationBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

                                <StackPanel>

                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource InformationBrush}"
                                        Text="{Binding NotReevaluatableFindingCountText, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Nicht erneut auswertbar"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>

                        </Grid>

                        <Grid Margin="0,16,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Padding="16"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

                                <StackPanel>

                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="Systemzustand" />

                                    <TextBlock
                                        Margin="0,7,0,0"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentBrush}"
                                        Text="{Binding SystemScoreText, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="{Binding SystemScoreReasonText, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Column="2"
                                Padding="16"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

                                <StackPanel>

                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="Hardwarezustand" />

                                    <TextBlock
                                        Margin="0,7,0,0"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentBrush}"
                                        Text="{Binding HardwareScoreText, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="{Binding HardwareScoreReasonText, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>

                        </Grid>

                        <Border
                            Margin="0,16,0,0"
                            Padding="14"
                            Background="{StaticResource SurfaceSecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                            <StackPanel>

                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="Ausgeführte technische Maßnahmen" />

                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{Binding ActionSummaryText, Mode=OneWay}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="{Binding RestartRequirementText, Mode=OneWay}"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

                <Border
                    Margin="0,18,0,0"
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">

                    <StackPanel>

                        <TextBlock
                            Text="Vergleich nach Bereichen"
                            Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBlock
                            Margin="0,4,0,14"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Die Bereichsauswertung zeigt, ob der jeweilige technische Zustand verbessert, unverändert oder nicht belastbar vergleichbar ist."
                            TextWrapping="Wrap" />

                        <ItemsControl
                            ItemsSource="{Binding AreaItems, Mode=OneWay}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Margin="0,0,0,9"
                                        Padding="13"
                                        Background="{StaticResource SurfaceSecondaryBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    Text="{Binding Title, Mode=OneWay}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="{Binding EvaluationText, Mode=OneWay}"
                                                    TextWrapping="Wrap" />

                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="{Binding BeforeFindingText, Mode=OneWay}" />

                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="&#xE72A;" />

                                            <TextBlock
                                                Grid.Column="3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="{Binding AfterFindingText, Mode=OneWay}" />

                                            <TextBlock
                                                Grid.Column="4"
                                                Margin="16,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{Binding StatusText, Mode=OneWay}">

                                                <TextBlock.Style>

                                                    <Style TargetType="TextBlock">

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{StaticResource InformationBrush}" />

                                                        <Style.Triggers>

                                                            <DataTrigger
                                                                Binding="{Binding Status, Mode=OneWay}"
                                                                Value="{x:Static models:CustomerCheckupAreaComparisonStatus.UnchangedHealthy}">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource SuccessBrush}" />

                                                            </DataTrigger>

                                                            <DataTrigger
                                                                Binding="{Binding Status, Mode=OneWay}"
                                                                Value="{x:Static models:CustomerCheckupAreaComparisonStatus.Improved}">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource SuccessBrush}" />

                                                            </DataTrigger>

                                                            <DataTrigger
                                                                Binding="{Binding Status, Mode=OneWay}"
                                                                Value="{x:Static models:CustomerCheckupAreaComparisonStatus.ImprovedButStillNeedsAttention}">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource WarningBrush}" />

                                                            </DataTrigger>

                                                            <DataTrigger
                                                                Binding="{Binding Status, Mode=OneWay}"
                                                                Value="{x:Static models:CustomerCheckupAreaComparisonStatus.UnchangedNeedsAttention}">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource WarningBrush}" />

                                                            </DataTrigger>

                                                            <DataTrigger
                                                                Binding="{Binding Status, Mode=OneWay}"
                                                                Value="{x:Static models:CustomerCheckupAreaComparisonStatus.Worsened}">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource DangerBrush}" />

                                                            </DataTrigger>

                                                            <DataTrigger
                                                                Binding="{Binding Status, Mode=OneWay}"
                                                                Value="{x:Static models:CustomerCheckupAreaComparisonStatus.NewlyNeedsAttention}">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource DangerBrush}" />

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </TextBlock.Style>

                                            </TextBlock>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <Border
                    Margin="0,18,0,0"
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter
                                Property="Visibility"
                                Value="Visible" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding HasImportantFindings, Mode=OneWay}"
                                    Value="False">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>

                    <StackPanel>

                        <TextBlock
                            Text="Offene, neue oder nicht erneut auswertbare Befunde"
                            Style="{StaticResource SectionTitleTextStyle}" />

                        <ItemsControl
                            Margin="0,14,0,0"
                            ItemsSource="{Binding ImportantFindingItems, Mode=OneWay}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{StaticResource SurfaceSecondaryBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="180" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    Text="{Binding Title, Mode=OneWay}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="{Binding AreaText, Mode=OneWay}" />

                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="{Binding SeverityText, Mode=OneWay}" />

                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{Binding StatusText, Mode=OneWay}">

                                                <TextBlock.Style>

                                                    <Style TargetType="TextBlock">

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{StaticResource InformationBrush}" />

                                                        <Style.Triggers>

                                                            <DataTrigger
                                                                Binding="{Binding Status, Mode=OneWay}"
                                                                Value="{x:Static models:CustomerCheckupFindingComparisonStatus.StillOpen}">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource WarningBrush}" />

                                                            </DataTrigger>

                                                            <DataTrigger
                                                                Binding="{Binding Status, Mode=OneWay}"
                                                                Value="{x:Static models:CustomerCheckupFindingComparisonStatus.NewlyDetected}">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource DangerBrush}" />

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </TextBlock.Style>

                                            </TextBlock>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <Border
                    Margin="0,18,0,0"
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter
                                Property="Visibility"
                                Value="Visible" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding HasComparisonNotes, Mode=OneWay}"
                                    Value="False">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>

                    <StackPanel>

                        <TextBlock
                            Text="Hinweise zur Vergleichbarkeit"
                            Style="{StaticResource SectionTitleTextStyle}" />

                        <ItemsControl
                            Margin="0,12,0,0"
                            ItemsSource="{Binding ComparisonNotes, Mode=OneWay}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <TextBlock
                                        Margin="0,0,0,7"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        TextWrapping="Wrap">

                                        <Run Text="• " />

                                        <Run
                                            Text="{Binding Mode=OneWay}" />

                                    </TextBlock>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <Border
                    Margin="0,18,0,0"
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10">

                    <StackPanel>

                        <TextBlock
                            Text="Technikerangaben"
                            Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBlock
                            Margin="0,4,0,18"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Diese Angaben werden im späteren Kundenbericht hervorgehoben. Alle drei Felder sind für den Abschlussentwurf erforderlich."
                            TextWrapping="Wrap" />

                        <TextBlock
                            Text="Technikerzusammenfassung"
                            Style="{StaticResource FormLabelTextStyle}" />

                        <TextBox
                            Height="110"
                            Margin="0,0,0,16"
                            Padding="12"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            MaxLength="3000"
                            Style="{StaticResource FormTextBoxStyle}"
                            Text="{Binding TechnicianSummary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Text="Nächste Schritte"
                            Style="{StaticResource FormLabelTextStyle}" />

                        <TextBox
                            Height="110"
                            Margin="0,0,0,16"
                            Padding="12"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            MaxLength="3000"
                            Style="{StaticResource FormTextBoxStyle}"
                            Text="{Binding NextSteps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock
                                    Text="Nächster Checkup-Termin"
                                    Style="{StaticResource FormLabelTextStyle}" />

                                <DatePicker
                                    Height="40"
                                    Background="{StaticResource SurfaceSecondaryBrush}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CalendarStyle="{StaticResource CustomerCheckupCalendarStyle}"
                                    SelectedDate="{Binding NextCheckupDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                                    <DatePicker.Resources>

                                        <Style TargetType="{x:Type DatePickerTextBox}">

                                            <Setter
                                                Property="Background"
                                                Value="{StaticResource SurfaceSecondaryBrush}" />

                                            <Setter
                                                Property="Foreground"
                                                Value="{StaticResource TextPrimaryBrush}" />

                                            <Setter
                                                Property="CaretBrush"
                                                Value="{StaticResource TextPrimaryBrush}" />

                                            <Setter
                                                Property="SelectionBrush"
                                                Value="{StaticResource AccentBrush}" />

                                            <Setter
                                                Property="BorderThickness"
                                                Value="0" />

                                            <Setter
                                                Property="Padding"
                                                Value="10,0" />

                                            <Setter
                                                Property="VerticalContentAlignment"
                                                Value="Center" />

                                        </Style>

                                    </DatePicker.Resources>

                                </DatePicker>

                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,8"
                                FontSize="11"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="Der Termin muss nach dem Nachher-Scan liegen."
                                TextWrapping="Wrap" />

                        </Grid>

                        <Border
                            Margin="0,16,0,0"
                            Padding="12"
                            Background="{StaticResource SurfaceSecondaryBrush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="7">

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding ValidationMessage, Mode=OneWay}"
                                            Value="">

                                            <Setter
                                                Property="Visibility"
                                                Value="Collapsed" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                            <TextBlock
                                Foreground="{StaticResource DangerBrush}"
                                Text="{Binding ValidationMessage, Mode=OneWay}"
                                TextWrapping="Wrap" />

                        </Border>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="28,18"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="Nachher-Scan und Angaben werden als Entwurf gespeichert; noch kein PDF und kein endgültiger Abschluss."
                    TextWrapping="Wrap" />

                <Button
                    Grid.Column="1"
                    Width="120"
                    Height="40"
                    Content="Abbrechen"
                    IsCancel="True" />

                <Button
                    Grid.Column="3"
                    MinWidth="180"
                    Height="40"
                    Content="Entwurf speichern"
                    IsDefault="True"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveDraftButton_OnClick" />

            </Grid>

        </Border>

    </Grid>

</Window>