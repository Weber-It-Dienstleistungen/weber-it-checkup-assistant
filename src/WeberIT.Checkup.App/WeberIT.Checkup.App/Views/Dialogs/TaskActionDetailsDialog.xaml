<Window
    x:Class="WeberIT.Checkup.App.Views.Dialogs.TaskActionDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:WeberIT.Checkup.App.Models"
    Title="Behebung"
    Width="760"
    Height="760"
    MinWidth="660"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            Padding="28"
            VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- Kopf -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="48"
                        Height="48"
                        VerticalAlignment="Top"
                        Background="{StaticResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="24">

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="21"
                            Foreground="{StaticResource AccentBrush}"
                            Text="&#xE9D2;" />

                    </Border>

                    <StackPanel Grid.Column="1">

                        <TextBlock
                            FontSize="21"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="{Binding ActionTitle}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="{Binding AvailabilityText}" />

                    </StackPanel>

                </Grid>

                <!-- Unterstützung -->

                <Border
                    Margin="0,24,0,0"
                    Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">

                    <StackPanel>

                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="VORGESEHENE UNTERSTÜTZUNG" />

                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="14"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />

                    </StackPanel>

                </Border>

                <!-- Risiko -->

                <Border
                    Margin="0,16,0,0"
                    Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="9">

                    <StackPanel>

                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource WarningBrush}"
                            Text="RISIKO UND AUSWIRKUNG" />

                        <TextBlock
                            Margin="0,8,0,0"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="{Binding RiskLevelText}" />

                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{Binding RiskDescription}"
                            TextWrapping="Wrap" />

                    </StackPanel>

                </Border>

                <!-- Rahmenbedingungen -->

                <Grid Margin="0,16,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">

                        <StackPanel>

                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="BERECHTIGUNG" />

                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding AdministratorRequirementText}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">

                        <StackPanel>

                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="NEUSTART" />

                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding RestartPossibilityText}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- Rein manuelle Unterstützung -->

                <Border
                    x:Name="PreparationOnlyNotice"
                    Margin="0,16,0,0"
                    Padding="14"
                    Background="{StaticResource SurfaceSecondaryBrush}"
                    BorderBrush="{StaticResource InformationBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <TextBlock
                        x:Name="PreparationOnlyNoticeTextBlock"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Diese Ansicht dient ausschließlich der Vorbereitung. Es wird kein Befehl gestartet und keine Einstellung verändert."
                        TextWrapping="Wrap" />

                </Border>

                <!-- Geführte Unterstützung -->

                <Border
                    x:Name="GuidedSupportNotice"
                    Margin="0,16,0,0"
                    Padding="14"
                    Background="{StaticResource SurfaceSecondaryBrush}"
                    BorderBrush="{StaticResource InformationBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{StaticResource InformationBrush}"
                            Text="Geführte Prüfung"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="GuidedSupportDescriptionTextBlock"
                            Margin="0,6,0,0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Die geführte Unterstützung öffnet ausschließlich eine passende Windows-Prüfansicht. Dort erfolgt keine automatische Änderung."
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="GuidedTargetDescriptionTextBlock"
                            Margin="0,7,0,0"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}"
                            TextWrapping="Wrap" />

                    </StackPanel>

                </Border>

                <!-- Ergebnis dokumentieren -->

                <Border
                    x:Name="ResolutionPanel"
                    Margin="0,20,0,0"
                    Padding="18"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Ergebnis dokumentieren" />

                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Nach der manuellen oder geführten Bearbeitung wird hier das Ergebnis festgehalten. Ohne Ergebnisübernahme bleibt die Aufgabe offen."
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,18,0,0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="ERGEBNIS" />

                        <Border
                            Margin="0,7,0,0"
                            Padding="14"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">

                            <StackPanel
                                x:Name="ResolutionStatusOptionsPanel">

                                <RadioButton
                                    Margin="0,0,0,10"
                                    Padding="5"
                                    Content="Erledigt"
                                    GroupName="ResolutionStatus"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Tag="{x:Static models:CheckupTaskStatus.Completed}" />

                                <RadioButton
                                    Margin="0,0,0,10"
                                    Padding="5"
                                    Content="Nicht durchführbar"
                                    GroupName="ResolutionStatus"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Tag="{x:Static models:CheckupTaskStatus.NotFeasible}" />

                                <RadioButton
                                    Padding="5"
                                    Content="Übersprungen"
                                    GroupName="ResolutionStatus"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Tag="{x:Static models:CheckupTaskStatus.Skipped}" />

                            </StackPanel>

                        </Border>

                        <TextBlock
                            Margin="0,18,0,0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="BEGRÜNDUNG – PFLICHTFELD" />

                        <TextBox
                            x:Name="StatusReasonTextBox"
                            MinHeight="72"
                            Margin="0,7,0,0"
                            Padding="10,8"
                            AcceptsReturn="True"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,18,0,0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="TECHNIKERNOTIZ – OPTIONAL" />

                        <TextBox
                            x:Name="TechnicianNoteTextBox"
                            MinHeight="72"
                            Margin="0,7,0,0"
                            Padding="10,8"
                            AcceptsReturn="True"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="ValidationTextBlock"
                            Margin="0,12,0,0"
                            FontSize="12"
                            Foreground="{StaticResource WarningBrush}"
                            TextWrapping="Wrap" />

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- Footer -->

        <Border
            Grid.Row="1"
            Padding="28,18"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="FooterStatusTextBlock"
                    Grid.Column="0"
                    Margin="0,0,18,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="Noch keine Ausführung oder Bestätigung"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="OpenGuidedViewButton"
                    Grid.Column="1"
                    MinWidth="190"
                    Height="40"
                    Content="Prüfansicht öffnen"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed"
                    Click="OpenGuidedViewButton_OnClick" />

                <Button
                    x:Name="ApplyResolutionButton"
                    Grid.Column="3"
                    MinWidth="170"
                    Height="40"
                    Content="Ergebnis übernehmen"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed"
                    Click="ApplyResolutionButton_OnClick" />

                <Button
                    Grid.Column="5"
                    Width="120"
                    Height="40"
                    Content="Abbrechen"
                    IsCancel="True"
                    Click="CloseButton_OnClick" />

            </Grid>

        </Border>

    </Grid>

</Window>