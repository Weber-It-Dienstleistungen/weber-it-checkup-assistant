<Window
    x:Class="WeberIT.Checkup.App.Views.Windows.CustomerDeviceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:checkup="clr-namespace:WeberIT.Checkup.App.Views.Controls.Checkup"
    Width="1280"
    Height="850"
    MinWidth="980"
    MinHeight="650"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Geräte- und Aktionskopf -->

        <Border
            Grid.Row="0"
            Padding="28,22"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">

            <StackPanel>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="42"
                        Height="42"
                        VerticalAlignment="Top"
                        Background="{StaticResource SurfaceSecondaryBrush}"
                        CornerRadius="10">

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="19"
                            Text="&#xE7F8;">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter
                                        Property="Foreground"
                                        Value="{StaticResource AccentBrush}" />

                                    <Style.Triggers>

                                        <MultiDataTrigger>

                                            <MultiDataTrigger.Conditions>

                                                <Condition
                                                    Binding="{Binding SelectedDevice.CheckupSession.HasCompletedCustomerCheckupVisit}"
                                                    Value="True" />

                                                <Condition
                                                    Binding="{Binding SelectedDevice.CheckupSession.HasInProgressCustomerCheckupVisit}"
                                                    Value="False" />

                                            </MultiDataTrigger.Conditions>

                                            <Setter
                                                Property="Foreground"
                                                Value="{StaticResource SuccessBrush}" />

                                        </MultiDataTrigger>

                                        <DataTrigger
                                            Binding="{Binding SelectedDevice.CheckupSession.HasInProgressCustomerCheckupVisit}"
                                            Value="True">

                                            <Setter
                                                Property="Foreground"
                                                Value="{StaticResource WarningBrush}" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                FontSize="21"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding SelectedDevice.DisplayName}"
                                TextWrapping="Wrap" />

                            <Border
                                Margin="14,0,0,0"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                BorderBrush="{StaticResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="5">

                                <Border.Style>

                                    <Style TargetType="Border">

                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding SelectedDevice.CheckupSession.HasInProgressCustomerCheckupVisit}"
                                                Value="True">

                                                <Setter
                                                    Property="Visibility"
                                                    Value="Visible" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Border.Style>

                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource WarningBrush}"
                                    Text="KUNDENCHECKUP LÄUFT" />

                            </Border>

                        </StackPanel>

                        <StackPanel
                            Margin="0,5,0,0"
                            Orientation="Horizontal">

                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding SelectedDevice.CheckupSession.DeviceInformation.Manufacturer}" />

                            <TextBlock
                                Margin="6,0"
                                FontSize="12"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="·" />

                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding SelectedDevice.CheckupSession.DeviceInformation.Model}" />

                            <TextBlock
                                Margin="16,0,0,0"
                                FontSize="12"
                                Foreground="{StaticResource TextMutedBrush}">

                                <TextBlock.Text>

                                    <MultiBinding StringFormat="{}Scan: {0:dd.MM.yyyy HH:mm}">
                                        <Binding Path="SelectedDevice.CheckupSession.ScanDate" />
                                    </MultiBinding>

                                </TextBlock.Text>

                            </TextBlock>

                        </StackPanel>

                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Width="120"
                        Height="38"
                        VerticalAlignment="Center"
                        Content="Schließen"
                        IsCancel="True" />

                </Grid>

                <!-- Checkupsteuerung -->

                <WrapPanel
                    Margin="56,20,0,0"
                    HorizontalAlignment="Right">

                    <Button
                        Width="170"
                        Height="40"
                        Margin="0,0,10,0"
                        Command="{Binding RescanDeviceCommand}"
                        Content="{Binding RescanDeviceButtonText}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTip="Startet oder setzt den Kundencheckup für dieses Gerät fort." />

                    <Button
                        Width="190"
                        Height="40"
                        Margin="0,0,10,0"
                        Command="{Binding ExportCustomerCheckupReportCommand}"
                        Content="Kundenbericht erstellen"
                        ToolTip="Erzeugt den Kundencheckup-Bericht als PDF. Der Vorgang bleibt in Bearbeitung.">

                        <Button.Style>

                            <Style
                                TargetType="Button"
                                BasedOn="{StaticResource {x:Type Button}}">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding HasSelectedDevicePreparedCompletion}"
                                        Value="True">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                    <Button
                        Width="220"
                        Height="40"
                        Margin="0,0,10,0"
                        Command="{Binding CompleteCustomerCheckupCommand}"
                        Content="Kundencheckup abschließen"
                        ToolTip="Speichert zuerst den PDF-Bericht und schließt den Kundencheckup danach endgültig ab.">

                        <Button.Style>

                            <Style
                                TargetType="Button"
                                BasedOn="{StaticResource AccentButtonStyle}">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding HasSelectedDevicePreparedCompletion}"
                                        Value="True">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                    <Button
                        Width="120"
                        Height="40"
                        Command="{Binding DeleteDeviceCommand}"
                        Content="Gerät löschen"
                        Foreground="{StaticResource DangerBrush}" />

                </WrapPanel>

            </StackPanel>

        </Border>

        <!-- Arbeitsbereich -->

        <ScrollViewer
            Grid.Row="1"
            Padding="32"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <Grid>

                <!-- Scanfortschritt -->

                <Border
                    Padding="24"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsScanRunning}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>

                    <StackPanel>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding ScanContextTitle}" />

                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{Binding ScanContextDescription}"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Margin="24,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentBrush}"
                                Text="{Binding ScanProgressPercentageText}" />

                        </Grid>

                        <ProgressBar
                            Height="12"
                            Margin="0,20,0,0"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding ScanProgressPercentage, Mode=OneWay}"
                            Background="{StaticResource SurfaceSecondaryBrush}"
                            BorderThickness="0"
                            Foreground="{StaticResource AccentBrush}" />

                        <Border
                            Margin="0,16,0,0"
                            Padding="14"
                            Background="{StaticResource SurfaceSecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">

                            <StackPanel>

                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding ScanCurrentStepText}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,5,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{Binding ScanProgressSummaryText}"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </Border>

                        <ItemsControl
                            Margin="0,18,0,0"
                            ItemsSource="{Binding ScanSteps}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12,10"
                                        Background="{StaticResource SurfaceSecondaryBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Text="{Binding StepTitle}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="18,0,0,0"
                                                FontSize="11"
                                                Foreground="{StaticResource AccentBrush}"
                                                Text="{Binding StatusText}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="18,0,0,0"
                                                FontSize="11"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="{Binding DisplayMessage}"
                                                TextWrapping="Wrap" />

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- Normale Geräteansicht -->

                <StackPanel>

                    <StackPanel.Style>

                        <Style TargetType="StackPanel">

                            <Setter
                                Property="Visibility"
                                Value="Visible" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsScanRunning}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </StackPanel.Style>

                    <checkup:CheckupDetailsView
                        DataContext="{Binding SelectedDevice.CheckupSession}" />

                    <checkup:ProgramUpdatesCard
                        Margin="0,24,0,0"
                        DataContext="{Binding SelectedDevice.CheckupSession.ProgramUpdateInformation}" />

                    <checkup:CheckupTaskListCard
                        Margin="0,24,0,0"
                        CheckupSession="{Binding DataContext.SelectedDevice.CheckupSession, RelativeSource={RelativeSource AncestorType=Window}}"
                        DataContext="{Binding SelectedDevice.CheckupSession.TaskList}" />

                    <checkup:CustomerCheckupHistoryCard
                        Margin="0,24,0,0"
                        DataContext="{Binding SelectedDevice.CheckupSession}" />

                </StackPanel>

            </Grid>

        </ScrollViewer>

    </Grid>

</Window>